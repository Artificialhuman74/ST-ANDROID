<?xml version="1.0" encoding="utf-8"?>
<!--
   Controls Android 12+ cloud backup and device-to-device transfer.
   The consumer JWT (TokenStore's "auth" DataStore) is excluded from both —
   a restored/transferred install should re-authenticate, not silently
   resurrect a session token onto a different device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
